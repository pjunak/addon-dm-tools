{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["contractVersion", "token", "format", "mode", "summary", "warnings", "changes"],
  "properties": {
    "contractVersion": { "const": "import-preview-result.v1" }, "token": { "type": "string", "minLength": 20, "maxLength": 200 }, "format": { "type": "string", "maxLength": 100 }, "mode": { "enum": ["merge", "replace"] },
    "summary": { "type": "object", "additionalProperties": false, "required": ["creates", "updates", "skips", "deletes"], "properties": { "creates": { "type": "integer", "minimum": 0 }, "updates": { "type": "integer", "minimum": 0 }, "skips": { "type": "integer", "minimum": 0 }, "deletes": { "type": "integer", "minimum": 0 } } },
    "warnings": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 500 } },
    "changes": { "type": "array", "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["collection", "id", "operation", "label"], "properties": { "collection": { "type": "string", "maxLength": 100 }, "id": { "type": "string", "maxLength": 120 }, "operation": { "enum": ["create", "update", "delete"] }, "label": { "type": "string", "maxLength": 200 } } } }
  }
}
