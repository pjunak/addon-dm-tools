{
  "$schema": "https://junak.eu/ttrpg-codex/contracts/addons/v3/service-document.schema.json",
  "contract": "codex.import-adapter", "version": "2.0.0", "allowsExclusive": false,
  "methods": {
    "describe": { "requestSchema": "contracts/empty.request.schema.json", "responseSchema": "contracts/import-description.response.schema.json", "maxDeadlineMs": 3000, "idempotency": "none", "errors": ["UNAVAILABLE"] },
    "preview": { "requestSchema": "contracts/import-preview.request.schema.json", "responseSchema": "contracts/import-preview.response.schema.json", "maxDeadlineMs": 15000, "idempotency": "none", "errors": ["INVALID_INPUT", "VALIDATION_FAILED", "UNAVAILABLE"] },
    "commit": { "requestSchema": "contracts/import-commit.request.schema.json", "responseSchema": "contracts/import-commit.response.schema.json", "maxDeadlineMs": 15000, "idempotency": "required", "errors": ["INVALID_INPUT", "NOT_FOUND", "CONFLICT", "UNAVAILABLE"] }
  }
}
