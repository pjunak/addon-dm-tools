{
  "$schema": "../ttrpg-codex/contracts/addons/v3/manifest.schema.json",
  "packageFormat": 1,
  "id": "dm-tools",
  "name": "DM Tools",
  "version": "3.0.0",
  "description": "DM-only nested story planning and reviewed planning imports.",
  "license": "MIT",
  "compatibility": {
    "host": ">=2.0.0 <3.0.0",
    "addonApi": "^3.0.0",
    "workerProtocol": "^1.0.0"
  },
  "capabilities": {
    "required": ["data.transactions", "ui.contributions", "worker.native"],
    "optional": []
  },
  "runtime": {
    "ui": { "mode": "integrated", "entry": "web/index.js", "styles": ["web/index.css"] },
    "worker": {
      "type": "native",
      "protocol": "^1.0.0",
      "entrypoints": {
        "windows-amd64": "worker/windows-amd64/dm-tools.exe",
        "linux-amd64": "worker/linux-amd64/dm-tools",
        "linux-arm64": "worker/linux-arm64/dm-tools"
      }
    }
  },
  "permissions": [],
  "contributions": [
    { "id": "dashboard.slot", "surface": "slot", "label": "Campaign Planning", "roles": ["dm"], "config": { "contractVersion": 1, "slot": "dm:dashboard" } },
    { "id": "planner.route", "surface": "route", "label": "Story Planner", "roles": ["dm"], "config": { "path": "planner" } },
    { "id": "planner.sidebar", "surface": "sidebar", "label": "Story Planner", "roles": ["dm"], "order": 200, "config": { "route": "planner.route" } },
    { "id": "imports.route", "surface": "route", "label": "Import Center", "roles": ["dm"], "config": { "path": "imports" } },
    { "id": "imports.sidebar", "surface": "sidebar", "label": "Import Center", "roles": ["dm"], "order": 210, "config": { "route": "imports.route" } }
  ],
  "collections": [
    { "id": "planning_items", "keyed": true, "visibility": "dm", "schema": "contracts/planning-item.schema.json", "schemaVersion": "3.0.0", "indexes": [{ "path": "/parentId" }, { "path": "/kind" }] },
    { "id": "planning_flow_links", "keyed": true, "visibility": "dm", "schema": "contracts/planning-flow.schema.json", "schemaVersion": "3.0.0", "indexes": [{ "path": "/sourceId" }, { "path": "/targetId" }] },
    { "id": "planning_references", "keyed": true, "visibility": "dm", "schema": "contracts/planning-reference.schema.json", "schemaVersion": "3.0.0", "indexes": [{ "path": "/itemId" }] },
    { "id": "planning_consequences", "keyed": true, "visibility": "dm", "schema": "contracts/planning-consequence.schema.json", "schemaVersion": "3.0.0" },
    { "id": "dm_notes", "keyed": true, "visibility": "dm", "schema": "contracts/dm-note.schema.json", "schemaVersion": "3.0.0" },
    { "id": "planning_views", "keyed": true, "visibility": "dm", "schema": "contracts/planning-view.schema.json", "schemaVersion": "3.0.0", "indexes": [{ "path": "/scopeId", "unique": true }] }
  ],
  "services": {
    "provides": [{ "contract": "codex.import-adapter", "version": "2.0.0", "transport": "worker", "schema": "contracts/import-adapter.service.json" }],
    "consumes": [{ "contract": "codex.import-adapter", "range": "^2.0.0", "cardinality": "many", "required": false, "selection": "all-compatible" }]
  }
}
