{
  "id": "dm-tools",
  "name": "DM Tools",
  "version": "0.8.0",
  "apiVersion": 2,
  "hostVersion": ">=1.0.0",
  "capabilities": {
    "required": [
      "collections.dm",
      "collections.transactions",
      "lifecycle.dispose",
      "i18n.catalogs",
      "imports.providers",
      "imports.bundle-contributors"
    ]
  },
  "entry": "entry.js",
  "server": "server/index.cjs",
  "locales": {
    "en": "locales/en.json",
    "cs": "locales/cs.json"
  },
  "permissions": [
    "data:own",
    "data:import-provider",
    "server:code",
    "ui:route",
    "ui:sidebar",
    "ui:action",
    "ui:slot:dm",
    "data:read:characters",
    "data:read:factions",
    "data:read:locations",
    "data:read:mysteries",
    "data:read:artifacts",
    "data:read:events"
  ],
  "collections": [
    {
      "name": "scenarios",
      "keyed": false,
      "access": "dm"
    },
    {
      "name": "planning_items",
      "keyed": true,
      "access": "dm"
    },
    {
      "name": "planning_folders",
      "keyed": true,
      "access": "dm"
    },
    {
      "name": "planning_links",
      "keyed": true,
      "access": "dm"
    },
    {
      "name": "planning_flow_links",
      "keyed": true,
      "access": "dm"
    },
    {
      "name": "planning_references",
      "keyed": true,
      "access": "dm"
    },
    {
      "name": "planning_consequences",
      "keyed": true,
      "access": "dm"
    },
    {
      "name": "dm_notes",
      "keyed": true,
      "access": "dm"
    },
    {
      "name": "planning_views",
      "keyed": true,
      "access": "dm"
    }
  ],
  "tests": {
    "client": [
      "tests/smoke.mjs",
      "tests/story-planner.mjs"
    ]
  },
  "summary": "DM-only nested story planner with reviewed bulk imports, named references, marginalia, consequences, and an interactive canvas."
}
