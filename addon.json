{
  "id": "dm-tools",
  "name": "DM Tools",
  "version": "0.5.0",
  "apiVersion": 2,
  "hostVersion": ">=1.0.0",
  "capabilities": {
    "required": [
      "collections.dm",
      "collections.transactions",
      "lifecycle.dispose",
      "i18n.catalogs",
      "imports.providers",
      "graphs.facade"
    ]
  },
  "entry": "entry.js",
  "server": "server/index.cjs",
  "locales": {
    "en": "locales/en.json",
    "cs": "locales/cs.json"
  },
  "permissions": [
    "data:own",
    "data:import-provider",
    "server:code",
    "ui:route",
    "ui:sidebar",
    "ui:action",
    "ui:graph",
    "ui:slot:dm"
  ],
  "collections": [
    {
      "name": "scenarios",
      "keyed": false,
      "access": "dm"
    }
  ],
  "tests": {
    "client": "tests/smoke.mjs"
  },
  "summary": "DM-only scenario workflows, reviewed JSON imports, a read-only graph, and the addon-owned DM dashboard."
}
