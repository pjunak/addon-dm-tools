{
  "id": "dm-tools",
  "name": "DM Tools",
  "version": "0.2.0",
  "apiVersion": 2,
  "hostVersion": ">=1.0.0",
  "capabilities": {
    "required": [
      "collections.dm",
      "collections.transactions",
      "lifecycle.dispose"
    ]
  },
  "entry": "entry.js",
  "permissions": [
    "data:own"
  ],
  "collections": [
    {
      "name": "scenarios",
      "keyed": false,
      "access": "dm"
    }
  ],
  "tests": {
    "client": "tests/smoke.mjs"
  },
  "summary": "Host-managed DM-only scenario storage for future DM Tools features."
}
